# --- Vector store: pgvector (default) | pinecone | chroma | atlas-mongo
VECTOR_DB_TYPE=pgvector
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
# Required: pick a strong password (compose refuses to start without it)
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# --- Embeddings
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_OPENAI_API_KEY=

# --- Chat graph (init_chat_model "provider:model"; needs the matching extra)
CHAT_MODEL=openai:gpt-5-mini
# GRADER_MODEL=openai:gpt-5-nano

# --- Optional
# PDF_PARSER=pypdf            # pypdf | llamaparse | docling
# LLAMA_CLOUD_API_KEY=
# LOCAL_EMBED_SCOPE=owner     # owner | any
# CORS_ORIGINS=http://localhost:5173

# --- Auth (unset = open, owner "public")
# JWT_SECRET=
# entity_id handling when JWT is on: claim (default, token "entities" claim) | trust (behind an authorising gateway, e.g. LibreChat) | deny
# ENTITY_ID_POLICY=claim
